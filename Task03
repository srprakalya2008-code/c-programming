#include <stdio.h>

#define SLAB1_UNITS 100
#define SLAB2_UNITS 200
#define RATE1_PAISE 225LL
#define RATE2_PAISE 450LL
#define FIXED_CHARGE_PAISE 5000LL

long long bill_paise(int units)
{
    long long payable = FIXED_CHARGE_PAISE;

    if (units > SLAB1_UNITS) {
        int slab1 = (units < SLAB2_UNITS)
                    ? units - SLAB1_UNITS
                    : SLAB2_UNITS - SLAB1_UNITS;
        payable += (long long)slab1 * RATE1_PAISE;
    }

    if (units > SLAB2_UNITS) {
        payable += (long long)(units - SLAB2_UNITS) * RATE2_PAISE;
    }

    return payable;
}

int main(void)
{
    int units;

    printf("Enter units consumed: ");
    if (scanf("%d", &units) != 1 || units < 0) {
        printf("Invalid units.\n");
        return 1;
    }

    long long bill = bill_paise(units);
    printf("Units: %d\n", units);
    printf("Total bill: Rs. %lld.%02lld\n", bill / 100, bill % 100);

    return 0;
}
